# Copy to .env (which is gitignored) and fill in.

# Your Cloudinary cloud name. Public — it appears in every image URL.
# Also set it as a GitHub repository variable named CLOUDINARY_CLOUD_NAME
# (Settings → Secrets and variables → Actions → Variables).
PUBLIC_CLOUDINARY_CLOUD_NAME=

# Only needed locally, for `npm run photos:import`. NEVER commit these.
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional: Cloudinary folder for imported photos.
# CLOUDINARY_FOLDER=portfolio/photos
