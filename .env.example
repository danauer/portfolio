# Copy to .env (which is gitignored) and fill in.

# Your Cloudinary cloud name. Public — it appears in every image URL.
# Also set it as a GitHub repository variable named CLOUDINARY_CLOUD_NAME
# (Settings → Secrets and variables → Actions → Variables).
PUBLIC_CLOUDINARY_CLOUD_NAME=

# Only needed locally, for `npm run photos:import`. NEVER commit these.
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional: Cloudinary folder for imported photos.
# CLOUDINARY_FOLDER=portfolio/photos

# Only needed locally, for `npm run steam:sync`. NEVER commit the key.
# Key: https://steamcommunity.com/dev/apikey
# ID: your 17-digit SteamID64 or custom profile name (steamcommunity.com/id/<name>)
STEAM_API_KEY=
STEAM_ID=

# Only needed locally, for `npm run psn:sync`. NEVER commit the token.
# NPSSO: sign in at https://www.playstation.com, then open
# https://ca.account.sony.com/api/v1/ssocookie and copy the 64-character "npsso" value.
# Expires after ~2 months.
PSN_NPSSO=

# Only needed locally, for `npm run xbox:sync`. NEVER commit the key.
# Sign in at https://xbl.io with your Xbox account and copy the API key.
XBL_API_KEY=

# For the Where to watch page (/watch/). Public: it ships in the page's JavaScript, because the
# site is static and the browser calls TMDB directly. Use TMDB's read-only "API Read Access Token"
# (or the v3 "API Key"): https://www.themoviedb.org/settings/api
# Also set it as a GitHub repository variable named TMDB_READ_TOKEN.
PUBLIC_TMDB_READ_TOKEN=
