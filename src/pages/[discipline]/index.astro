---
import { Image } from 'astro:assets';
import { getEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { disciplines, getProjects, type Discipline } from '../../lib/content';

export function getStaticPaths() {
  return Object.entries(disciplines).map(([discipline, { path }]) => ({
    params: { discipline: path },
    props: { discipline: discipline as Discipline },
  }));
}

const { discipline } = Astro.props;

// Size logos to a shared visual area (in rem²) rather than a shared height or width,
// so a very wide wordmark and a chunkier badge feel balanced next to each other.
const LOGO_AREA = 32;
const logoWidth = (logo: ImageMetadata) => +Math.sqrt(LOGO_AREA * (logo.width / logo.height)).toFixed(2);
const { label } = disciplines[discipline];
const projects = await getProjects(discipline);

// The UX page groups projects by client organization. Projects are already
// newest-first, so sections are ordered by their most recent project, and
// projects without a client go last. Other disciplines show one flat grid.
type Section = { id: string; name: string; description?: string | null; logo?: ImageMetadata | null; projects: typeof projects };
const sections: Section[] = [];
const unassigned: typeof projects = [];
const grouped = discipline === 'ux';
const tiles = discipline === 'visual';
for (const project of projects) {
  const client = project.data.client;
  if (!grouped || !client) {
    unassigned.push(project);
    continue;
  }
  let section = sections.find((s) => s.id === client.id);
  if (!section) {
    const org = (await getEntry(client))!.data;
    section = { id: client.id, name: org.name, description: org.description, logo: org.logo, projects: [] };
    sections.push(section);
  }
  section.projects.push(project);
}
if (unassigned.length) {
  // With no organizations to group under, skip the heading entirely.
  sections.push({ id: 'other', name: sections.length ? 'Other' : '', projects: unassigned });
}
---

<Base title={label}>
  <h1>{label}</h1>
  {
    sections.length ? (
      sections.map((section) => (
        <section class:list={['org', { split: grouped }]}>
          {(section.name || section.description) && (
            <div class="org-info">
              {section.name && (
                <h2 id={section.id}>
                  {section.logo ? (
                    <Image class="logo" src={section.logo} alt={section.name} height={160} style={`width: ${logoWidth(section.logo)}rem`} />
                  ) : (
                    section.name
                  )}
                </h2>
              )}
              {section.description && <p class="org-description">{section.description}</p>}
            </div>
          )}
          <ul class:list={['grid', { tiles, stack: grouped }]}>
            {section.projects.map((project) => (
              <ProjectCard project={project} shape={tiles ? 'square' : 'wide'} row={grouped} hoverPattern={tiles} />
            ))}
          </ul>
        </section>
      ))
    ) : (
      <p class="muted">Nothing here yet.</p>
    )
  }
</Base>

<style>
  .org { margin-top: 3rem; }
  /* Visual: square cards, 1px apart, at most three per row. */
  .tiles {
    gap: 1px;
    grid-template-columns: repeat(auto-fill, minmax(max(18rem, calc((100% - 2px) / 3)), 1fr));
  }
  .tiles :global(.card) { padding-bottom: 1.5rem; }
  .org-description { max-width: 40rem; margin: 0; color: var(--text-tertiary); }
  .org h2 { margin: 0 0 1rem; font-size: 1.5rem; }
  /* Width is set inline to give every logo the same area; never overflow the column. */
  .logo { height: auto; max-width: 100%; }

  /* UX: client details on the left, that client's projects stacked on the right. The logo/name
     sits in a row of its own, so the projects line up with the top of the description below it. */
  .stack { grid-template-columns: minmax(0, 1fr); margin: 0; }
  /* Below 768px the description stacks directly above the projects, so give it room. */
  @media (max-width: 767px) {
    .org-description { margin-bottom: 1.5rem; }
  }
  @media (min-width: 768px) {
    .split {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 2fr);
      grid-template-rows: auto 1fr;
      column-gap: var(--gap);
      align-items: start;
    }
    .split .org-info { display: contents; }
    .split h2 { grid-area: 1 / 1; }
    .split .org-description { grid-area: 2 / 1; }
    .split .stack { grid-area: 2 / 2; }
  }
</style>
