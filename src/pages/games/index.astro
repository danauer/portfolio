---
import Base from '../../layouts/Base.astro';
import Panel from '../../components/steam/Panel.astro';
import PickGrid from '../../components/games/PickGrid.astro';
import CarouselSection from '../../components/games/CarouselSection.astro';
import { backlog, newGames, onSale, withBanners } from '../../lib/recs';
import { analyze, capsule, snapshot as steamSnapshot, storeUrl } from '../../lib/steam';
import { snapshot as psnSnapshot, store as psnStore } from '../../lib/psn';
import { snapshot as xboxSnapshot, store as xboxStore } from '../../lib/xbox';
import { compact, date, hours, money, pct } from '../../lib/format';
import { url } from '../../lib/content';
import '../../styles/steam.css';

const owned = backlog();
const hero = await withBanners(owned.hero);
const fresh = newGames();
const sale = onSale();
const steam = analyze();
const hint = 'How closely it matches what you play. Compared within its own platform.';
const CAROUSEL = 12; // cards per carousel; the dedicated pages list everything, with a tab per platform
// Each carousel shows the "All" list; the platform tabs live on the full pages.
const unplayed = owned.tabs.find((t) => t.key === 'all')!;
const started = owned.resume.tabs.find((t) => t.key === 'all')!;
const newest = fresh.find((t) => t.key === 'all')!;
const discounted = sale.find((t) => t.key === 'all');
const latestSync = Math.max(...[steamSnapshot.generatedAt, psnSnapshot.generatedAt, psnStore.generatedAt, xboxSnapshot.generatedAt, xboxStore.generatedAt].map((d) => new Date(d).getTime())) / 1000;
---

<Base title="What to play" description="Games I already own and haven't played, plus what's worth buying next on Steam and PlayStation, and what to try on Xbox Game Pass.">
  <div class="games">
    <div class="steam-head">
      <div class="who">
        <div>
          <h1>What to play</h1>
          <p class="sub">Steam, PlayStation and Xbox · Updated {date(latestSync)} · <a href={url('games/under-the-hood')}>Under the hood →</a></p>
        </div>
      </div>
      <nav class="group-nav" aria-label="On this page">
        <a href="#start">Start here</a>
        <a href="#library">Never played</a>
        <a href="#resume">Pick up where you left off</a>
        <a href="#new">New games</a>
        {discounted && <a href="#sale">On sale</a>}
        <a href="#value">Value</a>
      </nav>
    </div>

    <section id="start">
      <h2>Start with one of these</h2>
      <PickGrid variant="feature" groups={[{ id: 'start-picks', title: '', blurb: '', items: hero }]} matchHint={hint} />
    </section>

    <CarouselSection id="library" title="More you've never played" items={unplayed.items.slice(0, CAROUSEL)} seeAll={{ href: url('games/never-played'), count: unplayed.items.length }} matchHint={hint} />

    <CarouselSection id="resume" title="Pick up where you left off" items={started.items.slice(0, CAROUSEL)} seeAll={{ href: url('games/pick-up'), count: started.items.length }} matchHint={hint} />

    <CarouselSection
      id="new"
      title="New games"
      items={newest.items.slice(0, CAROUSEL)}
      seeAll={{ href: url('games/new'), count: newest.items.length }}
      matchHint="How closely it matches your play history. Compared within its own store."
    />

    {
      discounted && (
        <CarouselSection
          id="sale"
          title="On sale now"
          items={discounted.items.slice(0, CAROUSEL)}
          seeAll={{ href: url('games/on-sale'), count: discounted.items.length }}
          matchHint="How closely it matches your play history. Compared within its own store."
        />
      )
    }

    <section id="value">
      <h2>Value</h2>
      <div class="panels">
        <Panel title="Best value per hour" note="Paid games with at least 2 hours">
          <ul class="game-list">
            {steam.bestValue.map((g) => (
              <li>
                <img src={capsule(g.appid)} alt="" loading="lazy" />
                <span class="title"><a href={storeUrl(g.appid)}>{g.name}</a><span class="meta-line">{money(g.priceCents, 2)} · {hours(g.minutes)}</span></span>
                <span class="figure">{money(g.perHour, 2)}<small>per hour</small></span>
              </li>
            ))}
          </ul>
        </Panel>
        <Panel title="Unplayed gems already in your library" note="Barely touched, ranked by Steam review confidence">
          <ul class="game-list">
            {steam.backlogGems.map((g) => (
              <li>
                <img src={capsule(g.appid)} alt="" loading="lazy" />
                <span class="title"><a href={storeUrl(g.appid)}>{g.name}</a><span class="meta-line">{g.minutes ? `${hours(g.minutes)} played` : 'Never launched'} · {compact(g.reviews!.positive + g.reviews!.negative)} reviews</span></span>
                <span class="figure">{pct(g.reviewPct)}<small>positive</small></span>
              </li>
            ))}
          </ul>
        </Panel>
        {steam.untouched.length > 0 && (
          <Panel title="Priciest untouched" note="Paid games with under 30 minutes played">
            <ul class="game-list">
              {steam.untouched.map((g) => (
                <li>
                  <img src={capsule(g.appid)} alt="" loading="lazy" />
                  <span class="title"><a href={storeUrl(g.appid)}>{g.name}</a><span class="meta-line">{g.minutes ? hours(g.minutes) : 'Never launched'}</span></span>
                  <span class="figure">{money(g.priceCents, 2)}</span>
                </li>
              ))}
            </ul>
          </Panel>
        )}
      </div>
    </section>

    <p class="source">
      Steam data from the Steam Web API, the Steam store and SteamSpy. PlayStation data from unofficial PSN endpoints and the public PlayStation Store. Xbox play history from OpenXBL; Xbox genres, ratings and prices from Microsoft's public store catalog.
      Prices are US store prices at capture time (Steam {date(new Date(steamSnapshot.generatedAt).getTime() / 1000)}, PlayStation {date(new Date(psnStore.generatedAt).getTime() / 1000)}, Xbox {date(new Date(xboxStore.generatedAt).getTime() / 1000)}).
      Match scores are only comparable within one platform. Xbox can't list games I own but haven't opened, and its play time is approximate. PS Plus claims and Game Pass games are only playable while subscribed. Value is Steam only, at today's list price rather than what I paid.
    </p>
  </div>
</Base>

<style>
  .group-nav { display: flex; flex-wrap: wrap; gap: 0.5rem 1.25rem; font-size: 0.9rem; }
  .group-nav a { text-decoration: none; color: var(--text-secondary); }
  .group-nav a:hover { color: var(--text-primary); text-decoration: underline; text-underline-offset: 0.2em; }
  .sub a { color: var(--text-secondary); }
  section { scroll-margin-top: 1.5rem; }
  .source { margin-top: 3.5rem; font-size: 0.8rem; color: var(--text-tertiary); max-width: 42rem; }
</style>
