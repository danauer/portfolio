---
import { ClientRouter } from 'astro:transitions';
import '@fontsource/cal-sans';
import '@fontsource-variable/inter';
import '../styles/global.css';
import ThemeToggle from '../components/ThemeToggle.astro';
import { getSettings, url } from '../lib/content';

interface Props {
  title?: string;
  description?: string | null;
}

const { title, description } = Astro.props;
const settings = await getSettings();
const siteName = settings?.name || 'Portfolio';
const nav = [
  {
    label: 'Works',
    links: [
      ['ux', 'UX'],
      ['visual', 'Visual'],
      // Hidden for now: ['art', 'Art'], ['photography', 'Photography'],
    ],
  },
  {
    label: 'Details',
    links: [
      ['timeline', 'Timeline'],
      ['about', 'About'],
    ],
  },
];
const current = Astro.url.pathname;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href={url('favicon.svg')} />
    <title>{title ? `${title} · ${siteName}` : siteName}</title>
    {description && <meta name="description" content={description} />}
    <script is:inline>
      // Apply the saved theme before first paint so there's no flash, and keep it across page swaps.
      const saved = localStorage.getItem('theme');
      if (saved === 'light' || saved === 'dark') document.documentElement.dataset.theme = saved;
      document.addEventListener('astro:before-swap', (event) => {
        const theme = document.documentElement.dataset.theme;
        if (theme) event.newDocument.documentElement.dataset.theme = theme;
      });
    </script>
    <ClientRouter />
  </head>
  <body>
    <div class="shell">
      <header class="site-header">
        <a href={url('/')} class="wordmark">{siteName}</a>
        <nav>
          {
            nav.map((group) => (
              <div class="nav-group">
                <span class="nav-label">{group.label}</span>
                {group.links.map(([path, label]) => (
                  <a href={url(path)} aria-current={current.startsWith(url(path)) ? 'page' : undefined}>
                    {label}
                  </a>
                ))}
              </div>
            ))
          }
        </nav>
        <ThemeToggle />
      </header>
      <div class="content">
        <main>
          <slot />
        </main>
      </div>
    </div>
  </body>
</html>
