---
import { ClientRouter } from 'astro:transitions';
import '@fontsource/cal-sans';
import '@fontsource-variable/inter';
import '../styles/global.css';
import ThemeToggle from '../components/ThemeToggle.astro';
import pixelPattern from '../assets/patterns/pixel-pattern.svg';
import { getSettings, url } from '../lib/content';

interface Props {
  title?: string;
  description?: string | null;
}

const { title, description } = Astro.props;
const settings = await getSettings();
const siteName = settings?.name || 'Portfolio';
const nav = [
  {
    label: 'Works',
    links: [
      ['ux', 'UX'],
      ['visual', 'Visual'],
      // Hidden for now: ['art', 'Art'], ['photography', 'Photography'],
    ],
  },
  {
    label: 'Details',
    links: [
      ['timeline', 'Timeline'],
      ['about', 'About'],
    ],
  },
];
const current = Astro.url.pathname;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href={url('favicon.svg')} />
    <title>{title ? `${title} · ${siteName}` : siteName}</title>
    {description && <meta name="description" content={description} />}
    <script is:inline>
      // Apply the saved theme before first paint so there's no flash, and keep it across page swaps.
      const saved = localStorage.getItem('theme');
      if (saved === 'light' || saved === 'dark') document.documentElement.dataset.theme = saved;
      document.addEventListener('astro:before-swap', (event) => {
        const theme = document.documentElement.dataset.theme;
        if (theme) event.newDocument.documentElement.dataset.theme = theme;
      });
    </script>
    <ClientRouter />
  </head>
  <body>
    <div class="shell">
      <header class="site-header" style={`--pattern: url(${pixelPattern.src})`}>
        <div class="header-bar">
          <a href={url('/')} class="wordmark">{siteName}</a>
          <button type="button" class="menu-button" aria-expanded="false" aria-controls="site-menu" aria-label="Menu">
            <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path class="menu-open" d="M4 7h16M4 12h16M4 17h16" />
              <path class="menu-close" d="M6 6l12 12M18 6 6 18" />
            </svg>
          </button>
        </div>
        <div class="site-menu" id="site-menu">
          <nav>
            {
              nav.map((group) => (
                <div class="nav-group">
                  <span class="nav-label">{group.label}</span>
                  {group.links.map(([path, label]) => (
                    <a href={url(path)} aria-current={current.startsWith(url(path)) ? 'page' : undefined}>
                      {label}
                    </a>
                  ))}
                </div>
              ))
            }
          </nav>
          <ThemeToggle />
        </div>
      </header>
      <div class="content">
        <main>
          <slot />
        </main>
      </div>
    </div>
    <script>
      // Mobile menu toggle. Re-bound on every client-side navigation; the header is re-rendered, so the menu starts closed.
      document.addEventListener('astro:page-load', () => {
        const header = document.querySelector<HTMLElement>('.site-header');
        const button = header?.querySelector<HTMLButtonElement>('.menu-button');
        if (!header || !button) return;
        const setOpen = (open: boolean) => {
          header.dataset.menu = open ? 'open' : 'closed';
          button.setAttribute('aria-expanded', String(open));
          button.setAttribute('aria-label', open ? 'Close menu' : 'Menu');
        };
        button.addEventListener('click', () => setOpen(header.dataset.menu !== 'open'));
        header.addEventListener('keydown', (event) => {
          if (event.key === 'Escape' && header.dataset.menu === 'open') {
            setOpen(false);
            button.focus();
          }
        });
      });
    </script>
  </body>
</html>
