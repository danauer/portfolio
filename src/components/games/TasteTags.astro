---
// A row of your strongest genres or tags for one store, each with a short bar for its weight in your play history.
interface Props {
  items: { label: string; weight: number }[];
  /** Colors the bar: steam (the default), psn or xbox. */
  source?: 'steam' | 'psn' | 'xbox';
  label: string;
}
const { items, source = 'steam', label } = Astro.props;
const max = Math.max(...items.map((t) => t.weight), 1);
---

<ul class="taste-tags" aria-label={label} data-source={source}>
  {items.map((t) => <li style={`--w: ${(100 * t.weight) / max}%`}><span>{t.label}</span></li>)}
</ul>

<style>
  .taste-tags { list-style: none; margin: 0 0 0.5rem; padding: 0; display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .taste-tags li {
    position: relative;
    padding: 0.35rem 0.75rem 0.5rem;
    border-radius: 0.375rem;
    background: var(--panel);
    font-size: 0.9rem;
    color: var(--text-primary);
    overflow: hidden;
  }
  .taste-tags li::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: 0;
    height: 3px;
    width: var(--w);
    background: var(--brand-steam);
    border-radius: 0 3px 3px 0;
  }
  .taste-tags[data-source='psn'] li::after { background: var(--brand-psn); }
  .taste-tags[data-source='xbox'] li::after { background: var(--brand-xbox); }
</style>
